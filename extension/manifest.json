{
  "manifest_version": 3,
  "name": "My-Fin",
  "version": "0.1.0",
  "description": "Atalho para o seu Gerenciador Financeiro Pessoal: abra o app, veja o patrimônio e lance transações.",
  "default_locale": "pt_BR",
  "action": {
    "default_popup": "popup.html",
    "default_title": "My-Fin"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "192": "icons/icon-192.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "omnibox": {
    "keyword": "fin"
  },
  "permissions": ["storage"],
  "host_permissions": []
}
