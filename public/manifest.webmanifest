{
  "name": "My-Fin — Gerenciador Financeiro Pessoal",
  "short_name": "My-Fin",
  "description": "Dashboard consolidado, extrato unificado com conciliação, contas e cartões de crédito, orçamentos mensais e relatórios.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#171717",
  "theme_color": "#171717",
  "lang": "pt-BR",
  "categories": ["finance", "productivity"],
  "handle_links": "preferred",
  "launch_handler": { "client_mode": "navigate-existing" },
  "protocol_handlers": [
    {
      "protocol": "web+myfin",
      "url": "/transactions?search=%s"
    }
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Nova transação",
      "short_name": "Nova transação",
      "url": "/transactions",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Extrato",
      "short_name": "Extrato",
      "url": "/transactions",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Orçamentos",
      "short_name": "Orçamentos",
      "url": "/budgets",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
